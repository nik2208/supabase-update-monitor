# Configurazione Supabase Monitor
# Questo file contiene le variabili di ambiente per lo script di monitoraggio

# Path al docker-compose.yml
export COMPOSE_DIR="/home/docker/dockerCompose/supabase/supatest"

# Path al clone git di Supabase (per estrarre lo SHA di docker/)
export GIT_REPO_DIR="/home/docker/dockerCompose/supabase/supabase"

# Configurazione LiteLLM (per analisi AI dei changelog)
export LITELLM_BASE_URL="https://litellm.applikat.it"
export LITELLM_API_KEY=""
export LITELLM_MODEL="groq/llama-3.3-70b-versatile"

# Configurazione SMTP (per invio email)
export SMTP_SERVER=""
export SMTP_PORT="587"
export SMTP_USER=""
export SMTP_PASSWORD=""
export MAIL_FROM=""
export MAIL_TO=""

# Path del file di log
export LOG_FILE="./supabase-monitor.log"
