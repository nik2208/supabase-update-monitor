# Configurazione Supabase Monitor
# Questo file contiene le variabili di ambiente per lo script di monitoraggio

# Path al docker-compose.yml
export COMPOSE_FILE="/path/to/docker-compose.yml"
export COMPOSE_S3_FILE="/path/to/docker-compose.s3.yml"
export ENV_FILE="/path/to/.env.supabase-monitor"

# Configurazione LiteLLM (per analisi AI dei changelog)
export LITELLM_BASE_URL="http://localhost:4000"
export LITELLM_API_KEY=""
export LITELLM_MODEL="gpt-3.5-turbo"

# Configurazione SMTP 
export SMTP_SERVER="smtp.gmail.com"
export SMTP_PORT="587"
export SMTP_USER=""  # Sostituisci con la tua email Gmail
export SMTP_PASSWORD=""  # Sostituisci con la tua app password di Gmail
export MAIL_FROM=""  # Sostituisci con la tua email (stesso di SMTP_USER)
export MAIL_TO=""  # Sostituisci con i destinatari (es: user1@example.com,user2@example.com)

# Path del file di log
export LOG_FILE="/tmp/supabase-monitor.log"
